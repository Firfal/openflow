{
  "name": "@openflow/check",
  "version": "0.1.0",
  "description": "OpenFlow Standard (OFS) checker: static analysis, sentinel rendering and HTML checks, with feedback formatted for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
