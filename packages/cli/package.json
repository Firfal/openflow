{
  "name": "openflow",
  "version": "0.1.0",
  "description": "OpenFlow CLI: create an editable Next.js site, check it against the OpenFlow Standard, run it locally and deploy it to Firebase.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openflow": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js && node scripts/copy-template.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openflow/check": "workspace:*",
    "@openflow/core": "workspace:*",
    "@openflow/functions": "workspace:*",
    "commander": "^15.0.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "react": "^19.3.0"
  }
}
