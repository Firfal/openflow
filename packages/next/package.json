{
  "name": "@openflow/next",
  "version": "0.1.0",
  "description": "OpenFlow for Next.js: static pages from the published snapshot, SEO metadata, sitemap and admin route.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@openflow/core": "workspace:*"
  },
  "peerDependencies": {
    "@openflow/admin": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@openflow/admin": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
