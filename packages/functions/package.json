  },
  "dependencies": {
    "@openflow/core": "workspace:*",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "react": "^19.3.0"
  }
