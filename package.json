{
  "name": "openflow-monorepo",
  "private": true,
  "description": "OpenFlow — CMS visuel open-source pour sites Next.js créés avec Claude Code, 100 % Firebase.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen:docs": "node scripts/gen-rule-docs.mjs",
    "check:docs": "node scripts/gen-rule-docs.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
