{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/openflow\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/node_modules/.bin/openflow\" hook post-tool-use --source project",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/openflow\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/node_modules/.bin/openflow\" hook stop --source project",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
